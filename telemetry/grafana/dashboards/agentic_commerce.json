    {
      "id": 901,
      "type": "timeseries",
      "title": "Token Usage Rate by Type",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 23
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (token_type) (rate(gen_ai_usage_tokens_total[5m]))",
          "legendFormat": "{{token_type}}",
          "refId": "A"
        }
      ]
    },
